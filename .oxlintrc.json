{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Not in jsx-a11y's recommended set. Its swaps (role="status" → <output>, role="img" on text initials → <img>)
    // have weaker assistive-technology support than the ARIA roles we use on purpose.
    "jsx-a11y/prefer-tag-over-role": "off",
    // Off in jsx-a11y's recommended set too: it can't see text rendered through components (<Code>{value}</Code>).
    "jsx-a11y/control-has-associated-label": "off",
    // A scrollable region must be focusable so keyboard users can scroll it (axe: scrollable-region-focusable).
    "jsx-a11y/no-noninteractive-tabindex": ["warn", { "roles": ["tabpanel", "region"], "tags": [] }]
  },
  "overrides": [
    {
      // shadcn-generated code: variant helpers exported next to components, Math.random for the
      // skeleton width and setState in the use-mobile effect. Only these rules are relaxed, only here.
      "files": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
      "rules": {
        "react/only-export-components": "off",
        "react/purity": "off",
        "react/set-state-in-effect": "off"
      }
    }
  ]
}
