{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{brand.light.canvas}"
      },
      "surface": {
        "$value": "{color.white}"
      },
      "surface-raised": {
        "$value": "{color.white}"
      },
      "subtle": {
        "$value": "{brand.light.subtle}"
      },
      "inverse": {
        "$value": "{color.neutral.900}"
      },
      "accent": {
        "$value": "{brand.light.accent}",
        "$description": "Brand tint for hover, active nav and selected rows. Neutral in the default brand."
      }
    },
    "fg": {
      "default": {
        "$value": "{color.black}"
      },
      "muted": {
        "$value": "{color.neutral.700}"
      },
      "subtle": {
        "$value": "{color.neutral.600}"
      },
      "inverse": {
        "$value": "{color.neutral.50}"
      },
      "on-action": {
        "$value": "{brand.light.primary-fg}"
      },
      "accent": {
        "$value": "{brand.light.accent-fg}"
      }
    },
    "border": {
      "default": {
        "$value": "{brand.light.border}"
      },
      "strong": {
        "$value": "{brand.light.border-strong}"
      },
      "focus": {
        "$value": "{brand.light.focus}"
      },
      "hover": {
        "$value": "{brand.light.border-hover}",
        "$description": "Control outline on hover. Same as border.strong in the default brand."
      }
    },
    "action": {
      "primary": {
        "base": {
          "$value": "{brand.light.primary}"
        },
        "hover": {
          "$value": "{brand.light.primary-hover}"
        },
        "fg": {
          "$value": "{brand.light.primary-fg}"
        }
      },
      "secondary": {
        "base": {
          "$value": "{brand.light.secondary}"
        },
        "hover": {
          "$value": "{brand.light.secondary-hover}"
        },
        "fg": {
          "$value": "{brand.light.secondary-fg}"
        }
      },
      "danger": {
        "base": {
          "$value": "{color.red.600}"
        },
        "hover": {
          "$value": "{color.red.700}"
        },
        "fg": {
          "$value": "{color.white}"
        }
      },
      "danger-soft": {
        "base": {
          "$value": "{color.red.100}"
        },
        "hover": {
          "$value": "{color.red.200}"
        },
        "fg": {
          "$value": "{color.red.800}"
        }
      }
    },
    "status": {
      "info": {
        "bg": {
          "$value": "{color.blue.50}"
        },
        "fg": {
          "$value": "{color.blue.800}"
        },
        "border": {
          "$value": "{color.blue.200}"
        }
      },
      "success": {
        "bg": {
          "$value": "{color.green.50}"
        },
        "fg": {
          "$value": "{color.green.800}"
        },
        "border": {
          "$value": "{color.green.200}"
        }
      },
      "warning": {
        "bg": {
          "$value": "{color.amber.50}"
        },
        "fg": {
          "$value": "{color.amber.800}"
        },
        "border": {
          "$value": "{color.amber.200}"
        }
      },
      "danger": {
        "bg": {
          "$value": "{color.red.50}"
        },
        "fg": {
          "$value": "{color.red.800}"
        },
        "border": {
          "$value": "{color.red.200}"
        }
      },
      "neutral": {
        "bg": {
          "$value": "{color.neutral.100}"
        },
        "fg": {
          "$value": "{color.neutral.700}"
        },
        "border": {
          "$value": "{color.neutral.200}"
        }
      }
    },
    "confidence": {
      "high": {
        "$value": "{color.green.600}"
      },
      "medium": {
        "$value": "{color.amber.600}"
      },
      "low": {
        "$value": "{color.red.600}"
      }
    },
    "chart": {
      "$description": "Categorical data series (charts). Order: 1 blue, 2 amber, 3 green, 4 violet — adjacent series differ in hue and lightness. Never the only cue: legends and labels carry meaning.",
      "1": {
        "$value": "{brand.light.chart-1}"
      },
      "2": {
        "$value": "{brand.light.chart-2}"
      },
      "3": {
        "$value": "{brand.light.chart-3}"
      },
      "4": {
        "$value": "{brand.light.chart-4}"
      }
    },
    "chart-line": {
      "1": {
        "$value": "{brand.light.chart-line-1}"
      },
      "2": {
        "$value": "{brand.light.chart-line-2}"
      },
      "3": {
        "$value": "{brand.light.chart-line-3}"
      },
      "4": {
        "$value": "{brand.light.chart-line-4}"
      },
      "$description": "Outline of a chart mark. Same as the card surface in the default brand (reads as a gap); a brand with light fills sets a darker line so each mark keeps 3:1."
    },
    "highlight": {
      "citation": {
        "bg": {
          "$value": "{color.violet.100}"
        },
        "border": {
          "$value": "{color.violet.400}"
        }
      }
    },
    "nav": {
      "active": {
        "bg": {
          "$value": "{brand.light.nav-active}"
        },
        "fg": {
          "$value": "{brand.light.nav-active-fg}"
        }
      },
      "$description": "Active navigation item. Same as the accent tint in the default brand; a brand can make it stronger than hover."
    },
    "icon": {
      "accent": {
        "$value": "{brand.light.icon}"
      },
      "$description": "Navigation and header icons. Text colour in the default brand; a brand can tint them."
    },
    "avatar": {
      "bg": {
        "$value": "{brand.light.avatar}"
      },
      "fg": {
        "$value": "{brand.light.avatar-fg}"
      },
      "$description": "Initials avatar."
    }
  }
}
