{
  "radius": {
    "$type": "dimension",
    "inner": {
      "$value": "{radius.sm}"
    },
    "control": {
      "$value": "{radius.md}"
    },
    "surface": {
      "$value": "{radius.lg}"
    },
    "overlay": {
      "$value": "{radius.xl}"
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": "{shadow.sm}"
    },
    "overlay": {
      "$value": "{shadow.lg}"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "{font.family.sans}"
      },
      "code": {
        "$value": "{font.family.mono}"
      }
    },
    "size": {
      "$type": "dimension",
      "caption": {
        "$value": "{font.size.12}"
      },
      "body-lg": {
        "$value": "{font.size.16}"
      },
      "heading-sm": {
        "$value": "{font.size.18}"
      },
      "heading-md": {
        "$value": "{font.size.22}"
      },
      "heading-lg": {
        "$value": "{font.size.26}"
      },
      "display": {
        "$value": "{font.size.40}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": "{font.weight.regular}"
      },
      "label": {
        "$value": "{font.weight.medium}"
      },
      "strong": {
        "$value": "{font.weight.semibold}"
      },
      "heading": {
        "$value": "{font.weight.medium}"
      }
    },
    "line-height": {
      "$type": "number",
      "heading": {
        "$value": "{font.line-height.heading-4}"
      },
      "body": {
        "$value": "{font.line-height.paragraph-regular}"
      }
    }
  }
}
