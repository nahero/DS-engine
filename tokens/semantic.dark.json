{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{brand.dark.canvas}"
      },
      "surface": {
        "$value": "{color.neutral.800}"
      },
      "surface-raised": {
        "$value": "{color.neutral.950}"
      },
      "subtle": {
        "$value": "{brand.dark.subtle}"
      },
      "inverse": {
        "$value": "{color.neutral.50}"
      },
      "accent": {
        "$value": "{brand.dark.accent}"
      }
    },
    "fg": {
      "default": {
        "$value": "{color.white}"
      },
      "muted": {
        "$value": "{color.neutral.400}"
      },
      "subtle": {
        "$value": "{color.neutral.400}"
      },
      "inverse": {
        "$value": "{color.neutral.900}"
      },
      "on-action": {
        "$value": "{brand.dark.primary-fg}"
      },
      "accent": {
        "$value": "{brand.dark.accent-fg}"
      }
    },
    "border": {
      "default": {
        "$value": "{brand.dark.border}"
      },
      "strong": {
        "$value": "{brand.dark.border-strong}"
      },
      "focus": {
        "$value": "{brand.dark.focus}"
      },
      "hover": {
        "$value": "{brand.dark.border-hover}"
      }
    },
    "action": {
      "primary": {
        "base": {
          "$value": "{brand.dark.primary}"
        },
        "hover": {
          "$value": "{brand.dark.primary-hover}"
        },
        "fg": {
          "$value": "{brand.dark.primary-fg}"
        }
      },
      "secondary": {
        "base": {
          "$value": "{brand.dark.secondary}"
        },
        "hover": {
          "$value": "{brand.dark.secondary-hover}"
        },
        "fg": {
          "$value": "{brand.dark.secondary-fg}"
        }
      },
      "danger": {
        "base": {
          "$value": "{color.red.400}"
        },
        "hover": {
          "$value": "{color.red.500}"
        },
        "fg": {
          "$value": "{color.neutral.950}"
        }
      },
      "danger-soft": {
        "base": {
          "$value": "{color.red.950}"
        },
        "hover": {
          "$value": "{color.red.900}"
        },
        "fg": {
          "$value": "{color.red.300}"
        }
      }
    },
    "status": {
      "info": {
        "bg": {
          "$value": "{color.blue.950}"
        },
        "fg": {
          "$value": "{color.blue.200}"
        },
        "border": {
          "$value": "{color.blue.800}"
        }
      },
      "success": {
        "bg": {
          "$value": "{color.green.950}"
        },
        "fg": {
          "$value": "{color.green.200}"
        },
        "border": {
          "$value": "{color.green.800}"
        }
      },
      "warning": {
        "bg": {
          "$value": "{color.amber.950}"
        },
        "fg": {
          "$value": "{color.amber.200}"
        },
        "border": {
          "$value": "{color.amber.800}"
        }
      },
      "danger": {
        "bg": {
          "$value": "{color.red.950}"
        },
        "fg": {
          "$value": "{color.red.200}"
        },
        "border": {
          "$value": "{color.red.800}"
        }
      },
      "neutral": {
        "bg": {
          "$value": "{color.neutral.800}"
        },
        "fg": {
          "$value": "{color.neutral.200}"
        },
        "border": {
          "$value": "{color.neutral.700}"
        }
      }
    },
    "confidence": {
      "high": {
        "$value": "{color.green.500}"
      },
      "medium": {
        "$value": "{color.amber.500}"
      },
      "low": {
        "$value": "{color.red.500}"
      }
    },
    "chart": {
      "1": {
        "$value": "{color.blue.400}"
      },
      "2": {
        "$value": "{color.amber.400}"
      },
      "3": {
        "$value": "{color.green.400}"
      },
      "4": {
        "$value": "{color.violet.400}"
      }
    },
    "highlight": {
      "citation": {
        "bg": {
          "$value": "{color.violet.950}"
        },
        "border": {
          "$value": "{color.violet.500}"
        }
      }
    },
    "nav": {
      "active": {
        "bg": {
          "$value": "{brand.dark.nav-active}"
        },
        "fg": {
          "$value": "{brand.dark.nav-active-fg}"
        }
      }
    },
    "icon": {
      "accent": {
        "$value": "{brand.dark.icon}"
      }
    },
    "avatar": {
      "bg": {
        "$value": "{brand.dark.avatar}"
      },
      "fg": {
        "$value": "{brand.dark.avatar-fg}"
      }
    }
  }
}
